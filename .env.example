# Copiá este archivo como .env para configurar el servidor en tu compu
# (npm run dev y npm run import:sqlite lo leen solos). Todo es opcional:
# sin DATABASE_URL se usa PGlite (Postgres embebido, sin instalar nada).

# Postgres de produccion (Neon). Ej: postgresql://usuario:clave@host/neondb?sslmode=require
DATABASE_URL=

# URL publica de la app, sin barra final. Ej: https://bolsillox.com.ar
PUBLIC_URL=

# Conexiones a Postgres por instancia (opcional; en Vercel conviene 2).
PG_POOL_MAX=

# Login con Google (opcional). Sin estas dos, el boton no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envio de codigos por email con Resend (opcional). Sin esto, en tu compu el
# codigo se muestra en la consola. Ver DEPLOY.md, paso 6.
RESEND_API_KEY=
# Remitente (con un dominio verificado en Resend). Ej: bolsillox <hola@tudominio.com>
EMAIL_FROM=

# Email donde avisar los errores inesperados (opcional, usa el mismo Resend).
ALERT_EMAIL=

# Clave del cron diario de Vercel que manda los recordatorios de cuotas (opcional).
# Sin ella, los recordatorios salen igual pero solo cuando alguien usa la app.
CRON_SECRET=
